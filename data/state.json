    "\u6a2a\u9808\u8cc0\u306e\u5e02\u6c11\u6d3b\u52d5\u3092\u8a18\u9332\u3057\u7d9a\u3051\u305f\u30a2\u30de\u30c1\u30e5\u30a2\u5199\u771f\u5bb6\u3057\u306e\u3076\u300c\u5897G\u5199\u771f\u5c55\u300d",
    "\u65e5\u7523\u81ea\u52d5\u8eca\u30012027\u5e74\u5ea6\u306b\u8ffd\u6d5c\u5de5\u5834\u306e\u751f\u7523\u7d42\u4e86 \u4e5d\u5dde\u5de5\u5834\u3078\u751f\u7523\u79fb\u7ba1",
    "\u6a2a\u9808\u8cc0\u4e2d\u592e\u300c\u82e5\u677e\u30de\u30fc\u30b1\u30c3\u30c8\u300d\u3067\u30d3\u30a2\u30ac\u30fc\u30c7\u30f3 \u662d\u548c\u30ec\u30c8\u30ed\u306a\u300c\u6d41\u3057\u300d\u6f14\u594f\u3082",
    "\u6d77\u6d0b\u5730\u7403\u7814\u7a76\u8239\u300c\u307f\u3089\u3044\u300d \u6a2a\u9808\u8cc0\u65b0\u6e2f\u3067\u9000\u5f79\u8a18\u5ff5\u30a4\u30d9\u30f3\u30c8\u3001\u8239\u5185\u4e00\u822c\u516c\u958b\u3082",
    "\u6a2a\u9808\u8cc0\u4e2d\u592e\u99c5\u524d\u304c\u518d\u958b\u767a\u3001\u8907\u5408\u5546\u696d\u65bd\u8a2d\u306e\u8d85\u9ad8\u5c64\u30d3\u30eb\u7740\u5de5\u3078",
    "\u4eac\u6025\u4e09\u6d66\u6d77\u5cb8\u6cbf\u7dda\u306e\u6cb3\u6d25\u685c\u304c\u6e80\u958b \u300c\u685c\u307e\u3064\u308a\u300d\u3067\u306b\u304e\u308f\u3044",
    "\u300c\u6a2a\u9808\u8cc0\u30b5\u2015\u30ad\u30e5\u30e9\u30fc\u5de5\u5834\u300d\u3067\u518d\u751f\u30d7\u30e9\u30b9\u30c1\u30c3\u30af\u306e\u65b0\u7d20\u6750\u958b\u767a\u3001\u751f\u7523\u59cb\u307e\u308b",
    "\u6a2a\u9808\u8cc0\u672c\u6e2f\u3067\u30c9\u30a4\u30c4\u30d3\u2015\u30eb\u306e\u796d\u5178 \u300c\u30aa\u30af\u30c8\u30fc\u30d0\u30fc\u30d5\u30a7\u30b9\u30c8\u300d\u59cb\u307e\u308b",
    "\u6a2a\u9808\u8cc0\u306e\u5e02\u6c11\u5287\u56e3\u300cSUKA\u30df\u30e5\u30fc\u300d\u304c\u590f\u516c\u6f14 CF\u3067\u5354\u529b\u547c\u3073\u304b\u3051",
    "\u6620\u753b\uff62\u306f\u3060\u3057\u306e\u30b2\u30f3\u306f\u307e\u3060\u6012\u3063\u3066\u3044\u308b\uff63 \u53cd\u6226\u6f2b\u753b\u304b\u3089\u5e73\u548c\u8003\u5bdf",
    "\u6a2a\u9808\u8cc0\u30d0\u30a4\u30ea\u30f3\u30ac\u30eb \u591a\u69d8\u6027\u5c0a\u91cd\u306e\u6559\u80b2\u8a55\u4fa1 \u30b7\u30f3\u30ac\u30dd\u30fc\u30eb\u56fd\u969b\u30a2\u30ef\u30fc\u30c9\u53d7\u8cde",
    "\u8ffd\u6d5c\u3067\u300c\u8857\u982d\u306e\u3069\u81ea\u6162\u300d \u53c2\u52a0\u8005\u52df\u96c6",
    "\u30da\u30ea\u30fc\u6765\u822a\u524d\u591c\u3092\u77e5\u308b \u30aa\u30e9\u30f3\u30c0\u901a\u8a5e\u3001\u7acb\u77f3\u306e\u65e5\u8a18\u304b\u3089",
    "\u8aad\u307f\u7d42\u3048\u305f\u672c\u3001\u3053\u3069\u3082\u652f\u63f4\u306b \u304b\u306a\u3057\u3093\u5168\u5e97\u306b\u56de\u53ce\u7bb1",
    "\u5e02\u8b70\u4f1a\u4f1a\u6d3e\u300c\u4e00\u5e02\u6c11\uff08\u3044\u3061\u3057\u307f\u3093\uff09\u300d \u3042\u306a\u305f\u306e\u58f0\u3092\u3001\u6a2a\u9808\u8cc0\u306e\u653f\u7b56\u306b",
    "\u81ea\u5206\u3089\u3057\u3044\u958b\u696d\u3078\u4e00\u6b69 \u6a2a\u9808\u8cc0\u5546\u8b70\u6240\u3067\u30b9\u30af\u30fc\u30eb",
    "\u30a6\u30b9\u30a4\u30db\u30fc\u30e0\u6a2a\u9808\u8cc0\u4e2d\u592e\u5e97 \u8cc7\u7523\u306e\u6574\u7406\u30fb\u58f2\u5374\u306f\u7269\u4fa1\u9ad8\u306e\u4eca\u304c\u597d\u6a5f",
    "\u3042\u3063\u3068\u307b\u30fc\u3080\u30c7\u30b9\u30af",
    "\u4e09\u90ce\u52a9\u3092\u8ffd\u3046 \u301c\u3082\u3046\u3072\u3068\u308a\u306e\u30e9\u30b9\u30c8\u30b5\u30e0\u30e9\u30a4\u301c \u7b2c55\u56de \u6587\u30fb\u5199\u771f \u85e4\u91ce\u6d69\u7ae0",
    "\u6a2a\u9808\u8cc0\u5e02 24\u6642\u9593\u5bc4\u308a\u6dfb\u3046\uff21\uff29\u76f8\u8ac7 \u3044\u3064\u3067\u3082\u3069\u3053\u3067\u3082\u50be\u8074",
    "\u738b\u8005\u306e\u30d9\u30eb\u30c8\u306b\u8208\u5473\u6d25\u3005 \u5150\u7ae5\u990a\u8b77\u65bd\u8a2d\u306b\u8986\u9762\u30ec\u30b9\u30e9\u30fc",
    "\u6a2a\u9808\u8cc0\u5e02\u6559\u80b2\u59d4\u54e1\u4f1a\u306e\u6559\u80b2\u9577\u306b\u5c31\u3044\u305f \u751f\u7530 \u7814\u4e00\u3055\u3093 \u6a2a\u9808\u8cc0\u5e02\u5728\u52e4 44\u6b73",
    "\u30d3\u30fc\u30c1\u306b\u97ff\u304f\u9b42\u306e\u53eb\u3073 \u4e09\u6d66\u6d77\u5cb8\u3067\u30b4\u30b9\u30da\u30eb\u30e9\u30a4\u30d6",
    "\u30bd\u30ec\u30a4\u30e6\u306e\u4e18 \u82b1\u706b\u5927\u4f1a \u590f\u591c\u3092\u5f69\u308b500\u767a",
    "\u8449\u5c71\u90f7\u7dcf\u93ae\u5b88 \u68ee\u6238\u5927\u660e\u795e\u3067\u4e03\u4e94\u4e09 \u795e\u793e\u3068\u30de\u30ea\u30fc\u30ca\u3067\u4e88\u7d04\u4f1a\u958b\u50ac \u6674\u308c\u7740\u306e\u4e38\u660c \u6a2a\u6d5c\u5e97",
    "\u30bf\u30c3\u30af\u30b9\u6e2f\u5357 \u8eca\u58f2\u308b\u306a\u3089\u5730\u57df\u5bc6\u7740\u5e97\u3078 \u96fb\u8a71\u4e00\u672c\u3001\u7121\u6599\u3067\u51fa\u5f35\u67fb\u5b9a",
    "\u731b\u6691\u306e\u5927\u5730\u9707\u7d66\u6c34\u888b\u306e\u5099\u3048\u3092 \u81ea\u6cbb\u4f1a\u304b\u3089\u6ce8\u6587\u6025\u5897",
    "\u30a6\u30b9\u30a4\u30db\u30fc\u30e0\u9017\u5b50\u5e97 \u4e0d\u52d5\u7523\u8cb7\u53d6\u3092\u5f37\u5316\u4e2d \u5ba4\u5185\u305d\u306e\u307e\u307e\u58f2\u5374\u53ef\u80fd",
    "\u30c9\u30ad\u30e5\u30e1\u30f3\u30bf\u30ea\u30fc\u6620\u753b\u4e0a\u6620 \u300cYokosuka1953\u300d GI\u30d9\u30d3\u30fc\u3001\u30eb\u30fc\u30c4\u63a2\u308b\u65c5",
    "\u5e73\u548c\u306e\u5c0a\u3055\u3001\u5fd8\u308c\u306a\u3044 28\u65e5\u3001\u8b1b\u548c\u3084\u30a2\u30fc\u30c8\u5c55\u793a",
    "\u3054\u907a\u4f53\u5b89\u7f6e vol.48 \u4eba\u751f100\u5e74\u6642\u4ee3\u4eca\u304b\u3089\u59cb\u3081\u308b\u7d42\u6d3b\u306e\u30b9\u30b9\u30e1",
    "\u751f\u3054\u307f\u53ce\u96c6\u5e02\u6c11\u8aac\u660e\u4f1a \u5e02\u5185\u5404\u6240\u3067\u5b9f\u65bd",
    "\u5949\u4ed5\u56e3\u4f53 \u4f1a\u9577\u306e\u6a2a\u9854 \u7d46\u306a\u304f\u3057\u3066\u5949\u4ed5\u306a\u3057",
    "\u30ea\u30c8\u30a2\u30cb\u30a2\u306e\u97f3\u8272\u304c\u8449\u5c71\u3092\u5305\u3080 22\u65e5\u306b\u521d\u306e\u97f3\u697d\u4ea4\u6d41\u796d",
    "\u661f\u5ea7\u306b\u307e\u3064\u308f\u308b\u30a8\u30c8\u30bb\u30c8\u30e9 \u300c\u661f\u5ea7\u3068\u661f\u5ea7\u7dda\u300d",
    "\u30d3\u30fc\u30c1\u30c6\u30cb\u30b9 \u5165\u6c5f\u3055\u3093\uff08\u8449\u5c71\u753a\u4e00\u8272\uff09 \u56fd\u5185\u5973\u5b50\u30e9\u30f3\u30af\uff11\u4f4d\u306b\u6d6e\u4e0a",
    "\u30b9\u30ab\u30a4\u30e9\u30f3\u30ca\u30fc \u5c71\u5cb8\u5927\u5fd7\u3055\u3093 \u9017\u5b50\u304b\u3089\u4e16\u754c\u306e\u5c71\u3005\u3078\u6311\u3080",
    "\u5973\u5b50\u65e5\u672c\u30e9\u30f3\u30ad\u30f3\u30b0\uff11\u4f4d\u306b\u8e8d\u308a\u51fa\u305f\u30d3\u30fc\u30c1\u30c6\u30cb\u30b9\u30d7\u30ec\u30a4\u30e4\u30fc\u306e \u5165\u6c5f \u771f\u5b50\u3055\u3093 \u8449\u5c71\u753a\u4e00\u8272\u5728\u4f4f 33\u6b73",
    "\u5c0f\u5b66\u751f\u6f2b\u624d\u5e2b\u300c\u30ab\u30fc\u30c6\u30f3\u30ba\u300d \u5dfb\u304d\u8d77\u3053\u305b\u3001\u7834\u5929\u8352\u306a\u7b11\u3044 \u9017\u5b50\u304b\u3089\u300cM-1\u300d\u3078\u6311\u6226\u7d9a\u3051\u308b",
    "\u3042\u306a\u305f\u306e\u300c\u82d7\u5b57\u300d\u306e\u6b74\u53f2\u306f\uff1f \uff18\u670816\u65e5 \u5584\u884c\u96d1\u5b66\u5927\u5b66\u3067\u8b1b\u5ea7",
    "\u7121\u6599\u306e\u30de\u30cd\u30fc\u30bb\u30df\u30ca\u30fc 50\u4ee3\u304b\u3089\u306e\u8cc7\u7523\u904b\u7528 \u300c\u8caf\u91d1\u3060\u3051\u300d\u8131\u5374\u3057\u751f\u6daf\u5b89\u5fc3",
    "\u30a6\u30b9\u30a4\u30db\u30fc\u30e0\u85e4\u6ca2\u5e97 \uff62\u7a7a\u304d\u7269\u4ef6\u3001\u653e\u7f6e\u3057\u3066\u3044\u307e\u305b\u3093\u304b\uff63 \u7247\u4ed8\u3051\u4e0d\u8981\u3067\u3059\u3050\u306b\u58f2\u5374",
    "\u8cb7\u53d6\u5b9f\u7e3e500\u53f0\u4ee5\u4e0a \uff62\u611b\u8eca\u306e\u58f2\u5374 \u304a\u4efb\u305b\u3092\uff63 \u6700\u4f4e\uff12\u4e07\u5186\u301c\u51fa\u5f35\u67fb\u5b9a\u7121\u6599",
    "\u30b9\u30de\u30db\u5c02\u7528\u300c\uff35\uff29\u9280\u884c\u300d\u5b9a\u671f\u9810\u91d1\u30ad\u30e3\u30f3\u30da\u30fc\u30f3 \uff11\u5e74\u3082\u306e\u5186\u5b9a\u671f\u304c\u5e74\uff11\u30fb50\uff05 \u304d\u3089\u307c\u3057\u9280\u884c\u3067\u5bfe\u9762\u30b5\u30dd\u30fc\u30c8",
    "\u795e\u5c71(\u3053\u3046\u3084\u307e)\u679c\u6a39\u5712",
    "\u3055\u3068\u3046\u679c\u6a39\u5712",
    "\u6e58\u5357\u53f0\u99c5\u897f\u53e3\u30d0\u30b9\uff15\u5206 \u8cb7\u53d6\u5c02\u9580\u300c\u58f2\u308b\u30ca\u30d3\u300d \uff62\u30d1\u30fc\u30eb\u306f\u6368\u3066\u305a\u306b\u5f53\u5e97\u3078\uff63 \uff18\u6708\u672b\u307e\u3067\uff11\uff10\uff10\uff10\u5186\u4fdd\u8a3c\u30ad\u30e3\u30f3\u30da\u30fc\u30f3",
    "\u30d5\u30eb\u30fc\u30c4\u30d1\u30fc\u30af\u9577\u5f8c",
    "\u8cb7\u53d6\u5e97\u308f\u304b\u3070 \u6e58\u5357\u30e2\u30fc\u30eb\u30d5\u30a3\u30eb\u5e97 \u30c6\u30ec\u30ab\u30fb\u304a\u9152\u3092\u73fe\u91d1\u5316 \u5f37\u5316\u30ad\u30e3\u30f3\u30da\u30fc\u30f3 \uff18\u670820\u65e5\u307e\u3067",
    "\u8fbb\u5802\u8acf\u8a2a\u795e\u793e\u4f8b\u5927\u796d \u58ee\u5927\u306a\u4eba\u5f62\u5c71\u8eca\u304a\u76ee\u898b\u3048",
    "\u9d60\u6cbc\u4f0f\u898b\u7a32\u8377\u590f\u796d\u308a 8\u30019\u300111\u65e5 \u795e\u8f3f\u5de1\u884c\u306a\u3069",
    "\u682a\u5f0f\u4f1a\u793e \u5ead\u5e2b \u751f\u6a39 \u5ba4\u5185\u7dd1\u5316\u3067\u5c4a\u3051\u308b\u7dd1\u306e\u9b45\u529b \u8077\u4eba\u306e\u624b\u8155\u3001\u56fd\u969b\u5712\u82b8\u535a\u3067\u62ab\u9732",
    "\u85e4\u6ca2\u306e\u5949\u4ed5\u56e3\u4f53 \u4f1a\u9577\u306e\u300e\u6a2a\u9854\u300f \u30a4\u30ce\u30d9\u30fc\u30b7\u30e7\u30f3\u30b2\u30fc\u30c8\u30a6\u30a7\u30a4\u6e58\u5357\u30ed\u30fc\u30bf\u30ea\u30fc\u30af\u30e9\u30d6 \u4f1a\u9577 \u7b39\u5ca1 \u5c06\u592a\u90ce\u3055\u3093",
    "\u56de\u308b\u8f2a\u3001\u821e\u3046\u5e2f \u4f53\u64cd\u5927\u4f1a\u306b18\u56e3\u4f53321\u4eba",
    "\u6226\u6ca1\u8005\u6170\u970a\u7891\u3092\u5b88\u308b\u300c\u660e\u7167\u4f1a\u300d\u304c\u8170\u8d8a\u306e\u970a\u5149\u7121\u76e1\u5854\u3067\u6170\u970a\u796d\u3068\u30d0\u30b6\u30fc\u3092\uff18\u670813\u65e5\u5b9f\u65bd",
    "\u5927\u8239\u99c5\u304b\u3089\u5f92\u6b69\u570f\u5185 \u4ecb\u8b77\u4ed8\u304d\u6709\u6599\u8001\u4eba\u30db\u30fc\u30e0 \uff62\u30b5\u30cb\u30fc\u30b9\u30c6\u30fc\u30b8\u3067\u826f\u304b\u3063\u305f\uff63 \u3084\u308a\u305f\u3044\u3053\u3068\u304c\u53f6\u3046\u6bce\u65e5",
    "\u8cb7\u53d6\u5e97\u308f\u304b\u3070 \u305f\u307e\u3084\u938c\u5009\u624b\u5e83\u5e97 \u30c6\u30ec\u30ab\u30fb\u304a\u9152\u3092\u73fe\u91d1\u5316 \u5f37\u5316\u30ad\u30e3\u30f3\u30da\u30fc\u30f3 \uff18\u670820\u65e5\u307e\u3067",
    "\uff2a\uff21\u3055\u304c\u307f\u306e\u4ee3\u8868\u7406\u4e8b\u7d44\u5408\u9577\u306b\u5c31\u4efb\u3057\u305f \u9234\u6728 \u6f54\u3055\u3093 \u5bd2\u5ddd\u753a\u5728\u4f4f 72\u6b73",
    "\u590f\u771f\u3063\u76db\u308a\u3001\u6975\u4e0a\u30db\u30c6\u30eb\u30e9\u30f3\u30c1 \u938c\u5009\u30d1\u30fc\u30af\u30db\u30c6\u30eb\u3067\u8d05\u6ca2\u30d6\u30c3\u30d5\u30a7\uff06\u5b63\u7bc0\u306e\u4f1a\u5e2d",
    "\u7de8\u96c6\u5ba4\u304b\u3089\u306e\u304a\u77e5\u3089\u305b",
    "\u938c\u5009\u897f\u30e9\u30a4\u30aa\u30f3\u30ba\u30af\u30e9\u30d6 \u52a0\u85e4 \u6e05\u548c\u4f1a\u9577 \u300c\u611f\u8b1d\u306e\u5949\u4ed5\u300d\u3092\u80f8\u306b\u3001\u660e\u308b\u304f\u697d\u3057\u304f\u6d3b\u52d5\u3092",
    "\u938c\u5009\u30a4\u30f3\u30c6\u30eb\u306e\u9078\u624b\u3082\u53c2\u52a0\uff62\u30af\u30ec\u30b9\u30bf\u590f\u796d\u308a\uff63 \uff18\u670811\u65e5\u306b\u30b4\u30fc\u30eb\u30c9\u30af\u30ec\u30b9\u30c8\u30b9\u30bf\u30b8\u30a2\u30e0\u3067\u958b\u50ac",
    "\u4e16\u754c\u306e\u904a\u3073\u306b\u89e6\u308c\u305f\u4e00\u65e5 \u5c0f\u5b66\u751f\u304c\u4e2d\u56fd\u306e\u300c\u6295\u58fa\u300d\u3084\u30a4\u30b9\u30e9\u30a8\u30eb\u306e\u300c\u30dc\u30fc\u30c9\u30b2\u30fc\u30e0\u300d\u306a\u3069\u3092\u4f53\u9a13",
    "\u938c\u5009\u5e02 \u65b0\u5e81\u820e\u6574\u5099\u306e\u624b\u6cd5\u3092\u518d\u691c\u8a0e 17\u65e5\u306b\u6709\u8b58\u8005\u4f1a\u8b70",
    "\u938c\u5009\u845b\u539f\u5ca1\u30e9\u30a4\u30aa\u30f3\u30ba\u30af\u30e9\u30d6 \u5bae\u6ca2 \u8f1d\u4f1a\u9577",
    "\u938c\u5009\u30e9\u30a4\u30aa\u30f3\u30ba\u30af\u30e9\u30d6 \u6e21\u908a \u90e1\u53f8\u4f1a\u9577",
    "\u300c\u9003\u3052\u4e0a\u624b\u306e\u82e5\u541b\u300d\u4f5c\u8005\u306e\u677e\u4e95\u512a\u5f81\u3055\u3093\u306e\u4f5c\u54c1\u3082\uff01\u9db4\u5ca1\u516b\u5e61\u5bae\u3067\u300c\u307c\u3093\u307c\u308a\u796d\u300d\uff18\u6708\uff19\u65e5\u307e\u3067\u958b\u50ac\u4e2d",
    "\u6bcd\u305f\u3061\u306e\u6b4c\u58f0\u3001\u5168\u56fd\u306e\u821e\u53f0\u3078 \u6e05\u6cc9\u5973\u5b66\u9662\u30fb\u4fdd\u8b77\u8005\u5408\u5531\u56e3\u304c\u5feb\u6319",
    "\u4f11\u65e5\u306f\u938c\u5009\u3067\u97f3\u697d\u3092 \uff18\u670811\u65e5\u306822\u65e5\u306b\u30b3\u30f3\u30b5\u30fc\u30c8",
    "\u307f\u3093\u306a\u3067\u300c\u76c6\u8e0a\u308a\u300d\u3057\u3088\u3046 \u30c1\u30e3\u30ec\u30f3\u30b8\u30d1\u30fc\u30af\u8d64\u677e\u3067",
    "\u79e6\u91ce\u9ad8\u6821\uff11\uff10\uff10\u5468\u5e74\u8a18\u5ff5\u7279\u5225\u53f7 \u500b\u4eba\u30fb\u4f01\u696d\u5354\u8cdb\u3092\u52df\u96c6",
    "\u61d0\u304b\u3057\u306e\u30d5\u30a9\u30fc\u30af\u3092\u6b4c\u3046\u8b1b\u5ea7 \uff19\u6708\uff15\u65e5\u3001\u3046\u307f\u304b\u305c\u30c6\u30e9\u30b9\u3067",
    "\u6620\u753b\u300e\u9ed2\u5ddd\u306e\u5973\u305f\u3061\u300f\u4e0a\u6620\u4f1a \u677e\u539f\u6587\u679d\u76e3\u7763\u306e\u4f1a\u5834\u6328\u62f6\u3082",
    "\u6211\u304c\u5bb6\u306e\u53ce\u7d0d\u4e0d\u8db3\u306f\u30b5\u30cb\u30fc\uff22\uff2f\uff38\u3067\u89e3\u6c7a",
    "\u590f\u306e\u7279\u5225\u4f01\u753b \u4e0d\u52d5\u7523\uff13\u793e\u00d7\u30bf\u30a6\u30f3\u30cb\u30e5\u30fc\u30b9 \u4e0d\u52d5\u7523\u3092\u7121\u6599\u67fb\u5b9a \u5fdc\u52df\u7de0\u5207\u306f\uff19\u670811\u65e5\u307e\u3067",
    "\uff13\u4eba\u5236\u30d0\u30b9\u30b1 \uff62\uff13\uff38\uff13\uff63\u3092\u4f53\u9a13\u3057\u3088\u3046 \uff19\u670820\u65e5\u306b\u5c0f\u5b66\u751f\u5411\u3051\u5927\u4f1a",
    "\u8cb7\u53d6\u5e97\u308f\u304b\u3070 \u8305\u30f6\u5d0e\u5357\u53e3\u99c5\u524d\u5e97 \u30c6\u30ec\u30ab\u30fb\u304a\u9152\u3092\u73fe\u91d1\u5316 \u5f37\u5316\u30ad\u30e3\u30f3\u30da\u30fc\u30f3 \uff18\u670820\u65e5\u307e\u3067",
    "\u5bd2\u5ddd\u753a \u8a9e\u308a\u7d99\u3050\u539f\u7206\u306e\u8a18\u61b6 \uff18\u670820\u65e5 \u5348\u524d10\u6642\u304b\u3089",
    "\u6d88\u9632\u64cd\u6cd5\u5927\u4f1a\u3067\u512a\u826f\u8cde \u8305\u30f6\u5d0e\u304b\u3089\u7b2c20\u5206\u56e3\u304c\u51fa\u5834",
    "\uff62\u30e9\u30a4\u30d0\u30eb\uff63\uff12\u6821\u304c\u8e8d\u52d5 \u30bd\u30d5\u30c8\u30dc\u30fc\u30eb",
    "\u731b\u6691\u306e\u65e5\u3082\u5143\u6c17\u306b\u56de\u53ce \u7d44\u5408\u54e1 \u3054\u307f\u53ce\u96c6\u306b\u6c57",
    "\u5bd2\u5ddd\u753a \u512a\u826f\u5efa\u8a2d\u5de5\u4e8b\u3092\u8868\u5f70 \uff16\u793e\u306b\u8868\u5f70\u72b6\u30fb\u611f\u8b1d\u72b6",
    "\u677e\u6797\u4e2d\u5973\u5b50\u30d0\u30b9\u30b1\u90e8 \u6e58\u5357\u30d6\u30ed\u30c3\u30af\u5927\u4f1a\u3067\u2164 \u770c\u5927\u4f1a\u3067\u3082\u30d9\u30b9\u30c8\uff18",
    "\u6620\u753b\u3092\u901a\u3058\u5e73\u548c\u9858\u3046 \u798f\u7530\u3084\u3088\u3044\u3055\u3093",
    "\u6210\u5e74\u5f8c\u898b\u65b0\u5236\u5ea6\u3092\u5f01\u8b77\u58eb\u304c\u89e3\u8aac \uff19\u670818\u65e5\u306b\u5e73\u585a\u5e02\u3067",
    "\u9ad8\u7d1a\u6642\u8a08\u30fb\u30d6\u30e9\u30f3\u30c9\u30d0\u30c3\u30b0 \uff62\u6700\u5f8c\u306b\u4f7f\u3063\u305f\u306e\u306f\u3044\u3064\uff1f\uff63\u7720\u308b\u304a\u5b9d\u306f\u5927\u9ed2\u5c4b\u3078",
    "\u9177\u6691\u3067\u30de\u30a4\u30ab\u30fc\u9700\u8981\u6025\u5897\u6708\u3005\uff11\u4e07\uff15\u5343\u5186\u3067\u65b0\u8eca\u306b\u4e57\u308c\u308b",
    "\uff16\u6708\u8b70\u4f1a\u5831\u544a \u30b7\u30fc\u30c6\u30e9\u30b9\u591c\u306e\u5b89\u5168\u306f \u5e02\u8b70\u4f1a\u8b70\u54e1 \u5e73\u585a\u30e6\u30fc\u30c1\u30e5\u30fc\u30d0\u30fc\u3057\u3093",
    "\u304a\u305f\u304b\u3089\u3084\u897f\u516b\u5e61\u5e97 \u30d6\u30e9\u30f3\u30c9\u6642\u8a08\u30fb\u91d1\u30d7\u30e9\u30c1\u30ca\u9ad8\u4fa1\u8cb7\u53d6\u5f37\u5316 \uff18\u6708\u9650\u5b9a\u30ad\u30e3\u30f3\u30da\u30fc\u30f3\u3082",
    "\u4e2d\u4e95\u753a\u793e\u5354 \uff18\u670823\u65e5\u306b\u798f\u7949\u306e\u590f\u307e\u3064\u308a \u5404\u7a2e\u4f53\u9a13\u3084\u5c55\u793a\u3082",
    "\u6771\u6d77\u5927\u5b66\u677e\u524d\u8a18\u5ff5\u9928 \u5f6b\u523b\u30e1\u30f3\u30c6\u3092\u4f53\u9a13 \u5275\u7acb\u8005\u306e\u80f8\u50cf\u306a\u3069\u6e05\u6383",
    "\u6c34\u96e3\u4e8b\u6545\u306b\u5099\u3048 \u5927\u78ef\u6e2f\u3067\u6551\u52a9\u8a13\u7df4",
    "\u82b1\u83dc\u30ac\u30fc\u30c7\u30f3 \u65e5\u5dee\u3057\u306b\u8ca0\u3051\u305a\u590f\u306e\u5f69\u308a \u30bf\u30a4\u30bf\u30f3\u30d3\u30ab\u30b9\u306a\u3069\u898b\u3054\u308d",
    "\u5409\u6ca2\u3067\u30b8\u30a7\u30e9\u30fc\u30c8\u4f5c\u308a\u4f53\u9a13 \u5c0f\u5b66\u751f\u3068\u4fdd\u8b77\u800512\u7d44\u304c\u53c2\u52a0",
    "\u5e73\u585a\u5e02\u5728\u4f4f\u82a6\u5ddd\u3055\u3093 \u67d4\u8853\u30a2\u30b8\u30a2\u5927\u4f1a\u521d\u512a\u52dd \u683c\u4e0a\u306e\u76f8\u624b\u4e0b\u3059",
    "\u8c4a\u7a63\u7948\u308a \u8fb2\u5177\u3078\u611f\u8b1d \u516d\u6240\u795e\u793e\u3067\u4e07\u936c\u79ae\u796d",
    "8\u670823\u65e5\uff08\u65e5\uff09\u306b\u6620\u753b\u4f1a\u3092\u4e3b\u50ac\u3059\u308b\u5e73\u585a\u5e02\u5357\u56f3\u66f8\u9928\u9928\u9577\u306e \u5c0f\u6797 \u7950\u4f73\u5b50\u3055\u3093 \u5e73\u585a\u5e02\u5728\u4f4f 42\u6b73",
    "\u97d3\u56fd\u8a9e\u30b9\u30d4\u30fc\u30c1\u3067\u5168\u56fd\u3078 \u5e73\u585a\u6e58\u98a8\u9ad8\u306e\u5927\u585a\u3055\u3093",
    "\u5357\u56f3\u66f8\u9928\u3067\u5e73\u548c\u6620\u753b\u4f1a \uff18\u670823\u65e5\u3001\u5e73\u585a\u5927\u7a7a\u8972\u4e0a\u6620"
  ]
}
