    "\u938c\u5009\u306e\u30b5\u30c3\u30ab\u30fc\u5834\u3067\u590f\u307e\u3064\u308a 3000\u4eba\u8d85\u3067\u300c\u307f\u3093\u306a\u3067\u8e0a\u308d\u3046\u9ce9\u97f3\u982d\u300d\u3082",
